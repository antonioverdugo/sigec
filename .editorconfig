root = true

# Configuración general para todos los archivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[compose.yaml]
indent_size = 4

# Archivos PHP
[*.php]
indent_style = space
indent_size = 4

# Archivos Blade (plantillas Laravel)
[*.blade.php]
indent_style = space
indent_size = 4

# Archivos CSS / SCSS
[*.{css,scss}]
indent_style = space
indent_size = 2

# Archivos JavaScript / TypeScript
[*.{js,ts,vue}]
indent_style = space
indent_size = 2

# Archivos JSON
[*.json]
indent_style = space
indent_size = 2

# Archivos YAML / YML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Archivos Markdown
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
indent_style = space
indent_size = 2
